const STATUS = ['New', 'Contacted', 'In progress', 'Closed'];
const BASE_COLS = ['ID', 'Received', 'Status', 'Notes'];
const RESUME_FOLDER = 'Driftless website resumes';
const MAX_FILE_BYTES = 5 * 1024 * 1024;
const OK_EXT = ['pdf', 'doc', 'docx', 'rtf', 'txt', 'odt'];
const COMMAND_CENTER = 'https://claude.ai/artifact/DGjq93BQewwZxf4Vq69xQR';

/** Run once from the editor: creates the tabs, headers, status dropdowns and the resume folder. */
function setup() {
  Object.keys(SCHEMA).forEach(function (key) { sheetFor(key); });
  resumeFolder();
  const first = SpreadsheetApp.getActive().getSheetByName('Sheet1');
  if (first && first.getLastRow() === 0 && SpreadsheetApp.getActive().getSheets().length > 1) SpreadsheetApp.getActive().deleteSheet(first);
}

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Driftless')
    .addItem('Open inbox', 'openInboxDialog')
    .addItem('Set up tabs', 'setup')
    .addToUi();
}

function openInboxDialog() {
  const html = HtmlService.createHtmlOutputFromFile('Inbox').setWidth(1100).setHeight(720);
  SpreadsheetApp.getUi().showModalDialog(html, 'Driftless inbox');
}

// ------------------------------------------------------------------ public: website form posts
function doPost(e) {
  try {
    const body = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    const key = String(body.form || '');
    const s = SCHEMA[key];
    if (!s) return json({ ok: false, error: 'unknown form' });
    const f = body.fields || {};
    if (f.website_url) return json({ ok: true });          // hidden spam trap was filled in
    if (Number(body.elapsed) < 3) return json({ ok: true }); // sent faster than a person can type
    if (!rateOk()) return json({ ok: false, error: 'busy' });

    const id = Utilities.getUuid().slice(0, 8);
    const row = [id, new Date(), 'New', ''];
    s.fields.forEach(function (pair) { row.push(clean(f[pair[0]])); });
    if (s.file) row.push(body.file ? saveFile(body.file, f.name || 'resume', id) : '');
    row.push(clean(body.page));

    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try { sheetFor(key).appendRow(row); } finally { lock.releaseLock(); }

    notify(key, f, id);
    return json({ ok: true, id: id });
  } catch (err) {
    console.error(err);
    return json({ ok: false, error: 'server' });
  }
}

// ------------------------------------------------------------------ private: the inbox page
function doGet() {
  if (!isOwner()) {
    return HtmlService.createHtmlOutput('<p style="font-family:sans-serif;padding:24px">Driftless Workforce Group forms service.</p>');
  }
  return HtmlService.createHtmlOutputFromFile('Inbox')
    .setTitle('Driftless inbox')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function getInbox() {
  assertOwner();
  const out = { schema: SCHEMA, status: STATUS, sheetUrl: SpreadsheetApp.getActive().getUrl(), commandCenter: COMMAND_CENTER, items: {} };
  Object.keys(SCHEMA).forEach(function (key) {
    const sh = sheetFor(key);
    const n = sh.getLastRow();
    if (n < 2) { out.items[key] = []; return; }
    const vals = sh.getRange(1, 1, n, sh.getLastColumn()).getDisplayValues();
    const head = vals[0];
    out.items[key] = vals.slice(1).map(function (r) {
      const o = {}; head.forEach(function (h, i) { o[h] = r[i]; }); return o;
    }).reverse();
  });
  return out;
}

function updateItem(key, id, patch) {
  assertOwner();
  if (!SCHEMA[key]) throw new Error('Unknown list');
  const sh = sheetFor(key);
  const n = sh.getLastRow();
  if (n < 2) throw new Error('Not found');
  const ids = sh.getRange(2, 1, n - 1, 1).getValues().map(function (r) { return String(r[0]); });
  const i = ids.indexOf(String(id));
  if (i < 0) throw new Error('Not found');
  const row = i + 2;
  if (patch.status != null) {
    if (STATUS.indexOf(patch.status) < 0) throw new Error('Unknown status');
    sh.getRange(row, 3).setValue(patch.status);
  }
  if (patch.notes != null) sh.getRange(row, 4).setValue(clean(patch.notes));
  return true;
}

// ------------------------------------------------------------------ helpers
function isOwner() {
  const me = Session.getEffectiveUser().getEmail();
  const viewer = Session.getActiveUser().getEmail();
  return !!me && !!viewer && me.toLowerCase() === viewer.toLowerCase();
}
function assertOwner() { if (!isOwner()) throw new Error('Not allowed'); }

function headersFor(key) {
  const s = SCHEMA[key];
  return BASE_COLS.concat(s.fields.map(function (p) { return p[1]; }), s.file ? ['Resume'] : [], ['Page']);
}

function sheetFor(key) {
  const ss = SpreadsheetApp.getActive();
  const s = SCHEMA[key];
  let sh = ss.getSheetByName(s.tab);
  if (!sh) sh = ss.insertSheet(s.tab);
  if (sh.getLastRow() === 0) {
    const h = headersFor(key);
    sh.getRange(1, 1, 1, h.length).setValues([h]).setFontWeight('bold').setBackground('#efe7d4');
    sh.setFrozenRows(1);
    const rule = SpreadsheetApp.newDataValidation().requireValueInList(STATUS, true).build();
    sh.getRange(2, 3, Math.max(sh.getMaxRows() - 1, 1), 1).setDataValidation(rule);
    sh.getRange(2, 2, Math.max(sh.getMaxRows() - 1, 1), 1).setNumberFormat('mmm d, yyyy h:mm am/pm');
  }
  return sh;
}

function clean(v) {
  let s = v == null ? '' : String(v);
  s = s.slice(0, 5000).trim();
  if (/^[=+\-@]/.test(s)) s = "'" + s;   // stop text from being read as a spreadsheet formula
  return s;
}

function saveFile(file, who, id) {
  const ext = String(file.name || '').split('.').pop().toLowerCase();
  if (OK_EXT.indexOf(ext) < 0) return 'Not saved: file type';
  const bytes = Utilities.base64Decode(String(file.data || ''));
  if (bytes.length > MAX_FILE_BYTES) return 'Not saved: over 5 MB';
  const safe = String(who).replace(/[^\w .-]/g, '').slice(0, 60) || 'resume';
  const blob = Utilities.newBlob(bytes, String(file.type || 'application/octet-stream'), safe + ' - ' + id + '.' + ext);
  return resumeFolder().createFile(blob).getUrl();
}

function resumeFolder() {
  const p = PropertiesService.getScriptProperties();
  const id = p.getProperty('RESUME_FOLDER_ID');
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) { /* folder was removed; make a new one */ } }
  const f = DriveApp.createFolder(RESUME_FOLDER);
  p.setProperty('RESUME_FOLDER_ID', f.getId());
  return f;
}

function rateOk() {
  const c = CacheService.getScriptCache();
  const k = 'n' + Math.floor(Date.now() / 60000);
  const n = Number(c.get(k) || 0) + 1;
  c.put(k, String(n), 120);
  return n <= 30;
}

function notify(key, f, id) {
  const to = Session.getEffectiveUser().getEmail();
  if (!to) return;
  const s = SCHEMA[key];
  const who = f.company ? f.company + (f.name ? ' (' + f.name + ')' : '') : (f.name || 'Someone');
  const lines = s.fields.map(function (p) { return p[1] + ': ' + (f[p[0]] || '-'); });
  const inbox = PropertiesService.getScriptProperties().getProperty('INBOX_URL') || SpreadsheetApp.getActive().getUrl();
  const mail = {
    to: to,
    subject: 'Driftless website: ' + s.tab + ', ' + who,
    body: lines.join('\n') + '\n\nReference: ' + id + '\nOpen your inbox: ' + inbox,
    name: 'Driftless website'
  };
  if (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(f.email || ''))) mail.replyTo = String(f.email);
  MailApp.sendEmail(mail);
}

function json(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}
